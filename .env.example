# groq is the real LLM backend. demo only replays the two supplied examples.
AGENT_BACKEND=groq
# Create your key at https://console.groq.com/keys and put it in .env, not here.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Output-token ceilings per model call; shorter sections use the smaller ceiling.
GROQ_PLAN_TOKENS=4096
GROQ_SECTION_TOKENS=2048
GROQ_BRIEF_SECTION_TOKENS=1024
LLM_TIMEOUT_SECONDS=180
ARTIFACT_DIR=artifacts
